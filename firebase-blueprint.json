{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "friendsCount": { "type": "number" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "isAdmin": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["name", "email", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "A social feed post",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 5000 },
        "images": { "type": "array", "maxLength": 10 },
        "videos": { "type": "array", "maxLength": 2 },
        "privacy": { "type": "string", "enum": ["public", "friends", "only_me"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["authorId", "privacy", "status", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a post",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A private chat between users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "maxLength": 2 },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["participants", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message inside a conversation",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["senderId", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 50 },
        "message": { "type": "string", "maxLength": 500 },
        "isRead": { "type": "boolean" },
        "link": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["type", "message", "isRead", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Content moderation report",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "maxLength": 128 },
        "reportedId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 50 },
        "reason": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["reporterId", "reportedId", "type", "status", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Temporary 24h story",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 500 },
        "mediaUrl": { "type": "string", "maxLength": 500 },
        "mediaType": { "type": "string", "enum": ["image", "video", "text"] },
        "expiresAt": { "type": "timestamp" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["authorId", "mediaType", "expiresAt", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Global posts collection"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments on a post"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Chats"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages in chat"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Notifications for a user"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "User submitted reports"
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "Temporary stories"
    }
  }
}
